---
import { Zap, LayoutList, EyeOff, Palette } from '@lucide/astro';
import { benefits } from '../config/site';

// Map the config's icon key to a Lucide component.
const icons = { zap: Zap, layout: LayoutList, 'eye-off': EyeOff, palette: Palette } as const;
---

<section class="relative py-20 sm:py-24">
  <div class="mx-auto max-w-shell px-6 sm:px-8 lg:px-10">
    <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
      <div class="reveal lg:sticky lg:top-28 lg:self-start">
        <p class="text-[13px] font-semibold uppercase tracking-[0.18em] text-purple">Why it feels good</p>
        <h2 class="mt-3 font-display text-4xl font-extrabold tracking-tight text-ink sm:text-5xl">
          Less friction.<br /> More thinking.
        </h2>
        <p class="mt-5 max-w-sm text-[16.5px] leading-relaxed text-ink-500">
          Every part of {import.meta.env.PUBLIC_SITE_NAME ?? 'CreateYourNotes'} is
          built to get out of the way — so the distance between an idea and a
          written-down note stays short.
        </p>
      </div>

      <ul class="grid gap-4 sm:grid-cols-2">
        {
          benefits.map((b, i) => {
            const Icon = icons[b.icon as keyof typeof icons];
            return (
              <li class="reveal group rounded-3xl border border-ink-100 bg-white p-6 shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-lift" style={`transition-delay:${i * 70}ms`}>
                <span class="inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-purple text-white shadow-lift transition-transform duration-300 group-hover:scale-105">
                  <Icon size={20} />
                </span>
                <h3 class="mt-4 font-display text-lg font-bold text-ink">{b.title}</h3>
                <p class="mt-2 text-[14.5px] leading-relaxed text-ink-500">{b.body}</p>
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
</section>
