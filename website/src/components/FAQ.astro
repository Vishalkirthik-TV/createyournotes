---
import { Plus } from '@lucide/astro';
import { faq } from '../config/site';
---

<section id="faq" class="relative py-20 sm:py-24">
  <div class="mx-auto max-w-3xl px-4 sm:px-6">
    <div class="reveal text-center">
      <p class="text-[13px] font-semibold uppercase tracking-[0.18em] text-purple">Questions</p>
      <h2 class="mt-3 font-display text-4xl font-extrabold tracking-tight text-ink sm:text-5xl">
        Frequently asked
      </h2>
      <p class="mt-4 text-[16.5px] text-ink-500">
        Quick answers about the app, installing it, and where to go next.
      </p>
    </div>

    <div class="reveal mt-12 space-y-3" style="transition-delay:80ms">
      {
        faq.map((item) => (
          <details class="group overflow-hidden rounded-2xl border border-ink-100 bg-white shadow-card open:shadow-lift">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 sm:px-6 [&::-webkit-details-marker]:hidden">
              <h3 class="font-display text-[16px] font-semibold text-ink sm:text-[17px]">
                {item.question}
              </h3>
              <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-ink-100 text-ink-600 transition-transform duration-300 group-open:rotate-45 group-open:bg-purple group-open:text-white">
                <Plus size={16} />
              </span>
            </summary>
            <div class="px-5 pb-5 sm:px-6">
              <p class="text-[15px] leading-relaxed text-ink-500">{item.answer}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
