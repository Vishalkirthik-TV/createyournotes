---
import { Menu, X, Download, Star } from '@lucide/astro';
import GithubIcon from './GithubIcon.astro';
import { nav, download, links } from '../config/site';

/** GitHub API endpoint, derived from the single source of truth in site.ts. */
const repoApi = links.github.replace('https://github.com/', 'https://api.github.com/repos/');

/** Build-time star count; the client script refreshes it on every page load. */
let stars = 0;
try {
  const res = await fetch(repoApi, {
    headers: { 'User-Agent': 'createyournotes-site', Accept: 'application/vnd.github+json' },
  });
  if (res.ok) {
    const data = await res.json();
    if (typeof data.stargazers_count === 'number') stars = data.stargazers_count;
  }
} catch {
  /* offline build — the client script fills the count in at runtime */
}
---

<header
  id="site-header"
  data-stars-api={repoApi}
  class="fixed inset-x-0 top-0 z-50 transition-[background-color] duration-300"
>
  <div class="mx-auto flex h-16 max-w-shell items-center gap-3 px-6 sm:px-8 lg:px-10">
    <a href="/" class="group flex items-center gap-2.5" aria-label={`${import.meta.env.PUBLIC_SITE_NAME ?? 'CreateYourNotes'} home`}>
      <img src="/images/logo.png" alt="" width="30" height="30" class="h-[30px] w-[30px] transition-transform duration-300 group-hover:-rotate-6" />
      <span class="font-display text-[17px] font-extrabold tracking-tight text-ink">CreateYourNotes</span>
    </a>

    <nav class="ml-6 hidden items-center gap-1 md:flex" aria-label="Primary">
      {
        nav
          .filter((item) => item.href.startsWith('#'))
          .map((item) => (
            <a
              href={item.href}
              class="rounded-lg px-3 py-2 text-[14px] font-medium text-ink-600 transition-colors hover:bg-ink-100 hover:text-ink"
            >
              {item.label}
            </a>
          ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <!-- Give-me-a-star: shows the live star count, links to the repo -->
      <a
        href={links.github}
        target="_blank"
        rel="noopener noreferrer"
        title="Give me a star on GitHub"
        aria-label="Give me a star on GitHub"
        class="hidden items-center gap-1.5 rounded-full border border-ink-100 bg-white px-3 py-2 text-[13px] font-semibold text-ink-700 transition-colors hover:border-gold/60 sm:inline-flex"
      >
        <Star size={14} class="text-gold fill-current" />
        <span class="star-count">{stars}</span>
      </a>

      <!-- GitHub repo, right next to Download -->
      <a
        href={links.github}
        target="_blank"
        rel="noopener noreferrer"
        title="View source on GitHub"
        aria-label="View source on GitHub"
        class="hidden h-9 w-9 items-center justify-center rounded-lg border border-ink-100 bg-white text-ink-600 transition-colors hover:border-purple/40 hover:text-purple sm:inline-flex"
      >
        <GithubIcon size={16} />
      </a>

      <a
        href={download.url}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden items-center gap-2 rounded-full bg-purple px-4 py-2.5 text-[14px] font-semibold text-white shadow-lift transition-all duration-200 hover:-translate-y-0.5 hover:bg-purple-dark sm:inline-flex"
      >
        <Download size={15} />
        Download
      </a>

      <!-- Mobile menu toggle -->
      <button
        id="menu-toggle"
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-ink-100 bg-white text-ink md:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open navigation menu"
      >
        <Menu id="icon-open" size={20} />
        <X id="icon-close" size={20} class="hidden" />
      </button>
    </div>
  </div>

  <!-- Scroll hairline: opacity-only fade-in (a border would flash dark
       through transition-all because its start color is currentColor) -->
  <span
    id="header-hairline"
    class="pointer-events-none absolute inset-x-0 bottom-0 h-px bg-ink-200 opacity-0 transition-opacity duration-300"
  ></span>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden border-t border-ink-100 bg-soft/95 backdrop-blur md:hidden">
    <nav class="mx-auto max-w-shell space-y-1 px-6 py-4 sm:px-8" aria-label="Mobile">
      {
        nav.map((item) =>
          item.href.startsWith('#') ? (
            <a href={item.href} class="mobile-link block rounded-lg px-3 py-3 text-[15px] font-medium text-ink-700 hover:bg-ink-100">
              {item.label}
            </a>
          ) : (
            <a
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
              class="mobile-link flex items-center gap-2 rounded-lg px-3 py-3 text-[15px] font-medium text-ink-700 hover:bg-ink-100"
            >
              {item.label}
              <GithubIcon size={15} />
            </a>
          ),
        )
      }
      <a
        href={download.url}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-2 flex items-center justify-center gap-2 rounded-full bg-purple px-4 py-3 text-[15px] font-semibold text-white transition-colors hover:bg-purple-dark"
      >
        <Download size={16} />
        Download for Windows
      </a>

      <a
        href={links.github}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-2 flex items-center justify-center gap-2 rounded-full border border-ink-200 bg-white px-4 py-3 text-[15px] font-semibold text-ink-700"
      >
        <Star size={15} class="text-gold fill-current" />
        <span>Give me a star · <span class="star-count">{stars}</span></span>
      </a>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  const setOpen = (open: boolean) => {
    menu?.classList.toggle('hidden', !open);
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
  };

  toggle?.addEventListener('click', () => {
    setOpen(menu?.classList.contains('hidden') ?? true);
  });

  // Close the mobile menu when a link inside it is chosen.
  menu?.querySelectorAll('.mobile-link').forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });

  // Close on Escape and return focus to the toggle.
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu && !menu.classList.contains('hidden')) {
      setOpen(false);
      toggle?.focus();
    }
  });

  // Solidify the header background after a little scroll. The hairline only
  // fades its opacity, so no dark line can flash in during the transition.
  const hairline = document.getElementById('header-hairline');
  const onScroll = () => {
    const solid = window.scrollY > 12;
    header?.classList.toggle('bg-soft/85', solid);
    header?.classList.toggle('backdrop-blur-md', solid);
    hairline?.classList.toggle('opacity-100', solid);
    hairline?.classList.toggle('opacity-0', !solid);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Keep the star count live. The build-time value (rendered in the HTML)
  // stays as a graceful fallback if the API is unreachable or rate-limited.
  const starsApi = header?.dataset.starsApi;
  if (starsApi) {
    fetch(starsApi, { headers: { Accept: 'application/vnd.github+json' } })
      .then((res) => (res.ok ? res.json() : null))
      .then((data) => {
        const count = data?.stargazers_count;
        if (typeof count === 'number') {
          document
            .querySelectorAll('.star-count')
            .forEach((el) => { el.textContent = String(count); });
        }
      })
      .catch(() => undefined);
  }
</script>
