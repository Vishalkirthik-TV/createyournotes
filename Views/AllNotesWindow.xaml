<Window x:Class="HoldMyNotes.Views.AllNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="All Notes"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#FFF7F5ED"
        FontFamily="Segoe UI"
        ShowInTaskbar="True">

    <Window.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Background" Value="#FFEAE8DF"/>
            <Setter Property="BorderBrush" Value="#FFE0DED4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#FF45433F"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="FilterButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#FF77746D"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <DataTemplate x:Key="NoteListTemplate">
            <Grid Height="76" Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="ColorStripe"
                        Grid.Column="0"
                        Width="5"
                        HorizontalAlignment="Center"
                        CornerRadius="3"
                        Background="{Binding Color}"/>

                <CheckBox Grid.Column="1"
                          Width="22"
                          Height="22"
                          VerticalAlignment="Top"
                          Margin="0,14,0,0"
                          IsChecked="{Binding IsCompleted}"
                          IsHitTestVisible="False"/>

                <StackPanel Grid.Column="2" Margin="8,9,8,7">
                    <TextBlock Text="{Binding Title}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#FF35332F"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Preview}"
                               Margin="0,4,0,0"
                               FontSize="13"
                               FontFamily="Segoe Print"
                               Foreground="#FF77746D"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Top"
                            Margin="8,12,12,0">
                    <Border Background="#FFE7E5DD"
                            CornerRadius="10"
                            Padding="9,3"
                            Margin="0,0,8,0">
                        <TextBlock Text="{Binding StatusText}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#FF77746D"/>
                    </Border>
                    <TextBlock Text="{Binding RelativeTime}"
                               FontSize="11"
                               Foreground="#FF99968E"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="520"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: note library -->
        <Grid Grid.Column="0" Margin="20,18,16,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock Text="All Notes"
                           FontSize="19"
                           FontWeight="SemiBold"
                           Foreground="#FF4A4843"
                           VerticalAlignment="Center"/>
                <Button x:Name="ImportButton"
                        Content="↥  Import…"
                        Style="{StaticResource ToolbarButton}"
                        HorizontalAlignment="Right"
                        Click="ImportButton_Click"/>
            </Grid>

            <Grid Grid.Row="1" Margin="0,14,0,10">
                <Border Background="#FFECEAE2"
                        BorderBrush="#FFE1DED4"
                        BorderThickness="1"
                        CornerRadius="10"
                        Height="40">
                    <Grid>
                        <TextBlock Text="⌕"
                                   FontSize="20"
                                   Foreground="#FF99968E"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="SearchBox"
                                 Margin="38,0,60,0"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="14"
                                 Foreground="#FF45433F"
                                 VerticalContentAlignment="Center"
                                 TextChanged="SearchBox_TextChanged"/>
                        <TextBlock x:Name="CountText"
                                   HorizontalAlignment="Right"
                                   Margin="0,0,14,0"
                                   Foreground="#FF8C8982"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
                <Button x:Name="AllFilterButton" Content="All" Style="{StaticResource FilterButton}" Click="FilterButton_Click" Tag="All"/>
                <Button x:Name="ActiveFilterButton" Content="Active" Style="{StaticResource FilterButton}" Click="FilterButton_Click" Tag="Active"/>
                <Button x:Name="ArchivedFilterButton" Content="Archived" Style="{StaticResource FilterButton}" Click="FilterButton_Click" Tag="Archived"/>
            </StackPanel>

            <ListBox x:Name="NotesList"
                     Grid.Row="3"
                     ItemsSource="{Binding FilteredNotes}"
                     ItemTemplate="{StaticResource NoteListTemplate}"
                     SelectionChanged="NotesList_SelectionChanged"
                     MouseDoubleClick="NotesList_MouseDoubleClick"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#FFE8E6DE"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Grid>

        <Border Grid.Column="1" Background="#FFE2E0D7"/>

        <!-- RIGHT: selected note -->
        <Grid Grid.Column="2" Margin="24,22,24,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <Border Background="#FFDCE9F4"
                            CornerRadius="5"
                            Width="12"
                            Height="12"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="ACTIVE · IN"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#FF77746D"/>
                        <TextBlock Text="THE DECK"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#FF77746D"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="MarkCompleteButton"
                            Content="Mark complete"
                            Style="{StaticResource ToolbarButton}"
                            Click="MarkCompleteButton_Click"/>
                    <Button x:Name="ExportButton"
                            Content="Export…"
                            Style="{StaticResource ToolbarButton}"
                            Click="ExportButton_Click"/>
                    <Button x:Name="DeleteButton"
                            Content="Delete"
                            Style="{StaticResource ToolbarButton}"
                            Foreground="#FFB03B32"
                            Click="DeleteButton_Click"/>
                </StackPanel>
            </Grid>

            <Border x:Name="DetailCard"
                    Grid.Row="1"
                    Background="#FFB7D9FA"
                    CornerRadius="24"
                    Padding="24"
                    Effect="{x:Null}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock x:Name="DetailTitle"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="#FF20252A"/>
                        <TextBlock x:Name="DetailTime"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="#FF687B8D"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  Margin="0,18,0,18"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="DetailContent"
                                   FontFamily="Segoe Print"
                                   FontSize="19"
                                   LineHeight="29"
                                   Foreground="#FF26313B"
                                   TextWrapping="Wrap"/>
                    </ScrollViewer>

                    <Border Grid.Row="2"
                            Height="1"
                            Background="#55809AB3"
                            Margin="0,0,0,10"/>
                    <TextBlock x:Name="DetailMeta"
                               Grid.Row="2"
                               Margin="0,14,0,0"
                               FontSize="12"
                               Foreground="#FF687B8D"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
