<Window x:Class="HoldMyNotes.Views.AllNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:HoldMyNotes.Views"
        Title="HoldMyNotes"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#FFF5F3EC"
        FontFamily="Segoe UI"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

	<Window.Resources>

		<SolidColorBrush x:Key="WindowBackground"
                         Color="#FFF5F3EC"/>

		<SolidColorBrush x:Key="PanelBackground"
                         Color="#FFF9F8F3"/>

		<SolidColorBrush x:Key="SoftSurface"
                         Color="#FFECEAE2"/>

		<SolidColorBrush x:Key="SoftBorder"
                         Color="#FFE0DDD4"/>

		<SolidColorBrush x:Key="TextPrimary"
                         Color="#FF302F2C"/>

		<SolidColorBrush x:Key="TextSecondary"
                         Color="#FF74716A"/>

		<SolidColorBrush x:Key="TextTertiary"
                         Color="#FF97938A"/>

		<SolidColorBrush x:Key="HoverSurface"
                         Color="#FFF0EEE7"/>

		<SolidColorBrush x:Key="SelectedSurface"
                         Color="#FFE7E4DB"/>

		<SolidColorBrush x:Key="DangerText"
                         Color="#FFB33B32"/>


		<Style x:Key="ToolbarButton"
               TargetType="{x:Type Button}">

			<Setter Property="Height"
                    Value="36"/>

			<Setter Property="MinWidth"
                    Value="82"/>

			<Setter Property="Padding"
                    Value="14,0"/>

			<Setter Property="Margin"
                    Value="6,0,0,0"/>

			<Setter Property="Background"
                    Value="#FFEAE8DF"/>

			<Setter Property="BorderBrush"
                    Value="#FFE0DDD4"/>

			<Setter Property="BorderThickness"
                    Value="1"/>

			<Setter Property="Foreground"
                    Value="{StaticResource TextPrimary}"/>

			<Setter Property="FontSize"
                    Value="13"/>

			<Setter Property="FontWeight"
                    Value="SemiBold"/>

			<Setter Property="Cursor"
                    Value="Hand"/>

			<Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

			<Setter Property="VerticalContentAlignment"
                    Value="Center"/>

			<Setter Property="Template">

				<Setter.Value>

					<ControlTemplate TargetType="{x:Type Button}">

						<Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">

							<Grid>

								<Border x:Name="HoverOverlay"
                                        Background="#FFF1EFE8"
                                        CornerRadius="12"
                                        Opacity="0"/>

								<Border x:Name="PressedOverlay"
                                        Background="#FFE3E0D6"
                                        CornerRadius="12"
                                        Opacity="0"/>

								<ContentPresenter
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Margin="{TemplateBinding Padding}"/>

							</Grid>

						</Border>

						<ControlTemplate.Triggers>

							<Trigger Property="IsMouseOver"
                                     Value="True">

								<Trigger.EnterActions>

									<BeginStoryboard>

										<Storyboard>

											<DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0:0:0.14">

												<DoubleAnimation.EasingFunction>

													<QuinticEase EasingMode="EaseOut"/>

												</DoubleAnimation.EasingFunction>

											</DoubleAnimation>

										</Storyboard>

									</BeginStoryboard>

								</Trigger.EnterActions>

								<Trigger.ExitActions>

									<BeginStoryboard>

										<Storyboard>

											<DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.18">

												<DoubleAnimation.EasingFunction>

													<QuinticEase EasingMode="EaseOut"/>

												</DoubleAnimation.EasingFunction>

											</DoubleAnimation>

										</Storyboard>

									</BeginStoryboard>

								</Trigger.ExitActions>

							</Trigger>

							<Trigger Property="IsPressed"
                                     Value="True">

								<Trigger.EnterActions>

									<BeginStoryboard>

										<Storyboard>

											<DoubleAnimation Storyboard.TargetName="PressedOverlay"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0:0:0.06"/>

										</Storyboard>

									</BeginStoryboard>

								</Trigger.EnterActions>

								<Trigger.ExitActions>

									<BeginStoryboard>

										<Storyboard>

											<DoubleAnimation Storyboard.TargetName="PressedOverlay"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.12"/>

										</Storyboard>

									</BeginStoryboard>

								</Trigger.ExitActions>

							</Trigger>

							<Trigger Property="IsEnabled"
                                     Value="False">

								<Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.45"/>

							</Trigger>

						</ControlTemplate.Triggers>

					</ControlTemplate>

				</Setter.Value>

			</Setter>

		</Style>


		<Style x:Key="DangerButton"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource ToolbarButton}">

			<Setter Property="Foreground"
                    Value="{StaticResource DangerText}"/>

			<Setter Property="Background"
                    Value="#FFF4E9E6"/>

			<Setter Property="BorderBrush"
                    Value="#FFE9D5D0"/>

		</Style>


		<Style x:Key="FilterButton"
               TargetType="{x:Type Button}">

			<Setter Property="Height"
                    Value="32"/>

			<Setter Property="Padding"
                    Value="12,0"/>

			<Setter Property="Margin"
                    Value="0,0,5,0"/>

			<Setter Property="Background"
                    Value="Transparent"/>

			<Setter Property="BorderBrush"
                    Value="Transparent"/>

			<Setter Property="BorderThickness"
                    Value="1"/>

			<Setter Property="Foreground"
                    Value="{StaticResource TextSecondary}"/>

			<Setter Property="FontSize"
                    Value="12.5"/>

			<Setter Property="FontWeight"
                    Value="SemiBold"/>

			<Setter Property="Cursor"
                    Value="Hand"/>

			<Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

			<Setter Property="VerticalContentAlignment"
                    Value="Center"/>

			<Setter Property="Template">

				<Setter.Value>

					<ControlTemplate TargetType="{x:Type Button}">

						<Border x:Name="FilterBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">

							<Grid>

								<Border x:Name="FilterHoverOverlay"
                                        Background="#FFECEAE2"
                                        CornerRadius="10"
                                        Opacity="0"/>

								<Border x:Name="FilterPressedOverlay"
                                        Background="#FFE1DED4"
                                        CornerRadius="10"
                                        Opacity="0"/>

								<ContentPresenter
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Margin="{TemplateBinding Padding}"/>

							</Grid>

						</Border>

						<ControlTemplate.Triggers>

							<Trigger Property="IsMouseOver"
                                     Value="True">

								<Trigger.EnterActions>

									<BeginStoryboard>

										<Storyboard>

											<DoubleAnimation Storyboard.TargetName="FilterHoverOverlay"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0:0:0.14">

												<DoubleAnimation.EasingFunction>

													<QuinticEase EasingMode="EaseOut"/>

												</DoubleAnimation.EasingFunction>

											</DoubleAnimation>

										</Storyboard>

									</BeginStoryboard>

								</Trigger.EnterActions>

								<Trigger.ExitActions>

									<BeginStoryboard>

										<Storyboard>

											<DoubleAnimation Storyboard.TargetName="FilterHoverOverlay"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.18">

												<DoubleAnimation.EasingFunction>

													<QuinticEase EasingMode="EaseOut"/>

												</DoubleAnimation.EasingFunction>

											</DoubleAnimation>

										</Storyboard>

									</BeginStoryboard>

								</Trigger.ExitActions>

							</Trigger>

							<Trigger Property="IsPressed"
                                     Value="True">

								<Trigger.EnterActions>

									<BeginStoryboard>

										<Storyboard>

											<DoubleAnimation Storyboard.TargetName="FilterPressedOverlay"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0:0:0.06"/>

										</Storyboard>

									</BeginStoryboard>

								</Trigger.EnterActions>

								<Trigger.ExitActions>

									<BeginStoryboard>

										<Storyboard>

											<DoubleAnimation Storyboard.TargetName="FilterPressedOverlay"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.12"/>

										</Storyboard>

									</BeginStoryboard>

								</Trigger.ExitActions>

							</Trigger>

						</ControlTemplate.Triggers>

					</ControlTemplate>

				</Setter.Value>

			</Setter>

		</Style>


		<Style x:Key="NoteListItemStyle"
               TargetType="{x:Type ListBoxItem}">

			<Setter Property="Padding"
                    Value="0"/>

			<Setter Property="Margin"
                    Value="0,0,0,4"/>

			<Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

			<Setter Property="Background"
                    Value="Transparent"/>

			<Setter Property="BorderThickness"
                    Value="0"/>

			<Setter Property="Template">

				<Setter.Value>

					<ControlTemplate TargetType="{x:Type ListBoxItem}">

						<Border x:Name="ItemBorder"
                                Background="Transparent"
                                CornerRadius="13"
                                Padding="0">

							<Grid>

								<Border x:Name="HoverOverlay"
                                        Background="#FFF1EFE8"
                                        CornerRadius="13"
                                        Opacity="0"/>

								<Border x:Name="SelectedOverlay"
                                        Background="#FFE7E4DB"
                                        CornerRadius="13"
                                        Opacity="0"/>

								<ContentPresenter/>

							</Grid>

						</Border>

						<ControlTemplate.Triggers>

							<Trigger Property="IsMouseOver"
                                     Value="True">

								<Trigger.EnterActions>

									<BeginStoryboard>

										<Storyboard>

											<DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0:0:0.14">

												<DoubleAnimation.EasingFunction>

													<QuinticEase EasingMode="EaseOut"/>

												</DoubleAnimation.EasingFunction>

											</DoubleAnimation>

										</Storyboard>

									</BeginStoryboard>

								</Trigger.EnterActions>

								<Trigger.ExitActions>

									<BeginStoryboard>

										<Storyboard>

											<DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.18">

												<DoubleAnimation.EasingFunction>

													<QuinticEase EasingMode="EaseOut"/>

												</DoubleAnimation.EasingFunction>

											</DoubleAnimation>

										</Storyboard>

									</BeginStoryboard>

								</Trigger.ExitActions>

							</Trigger>

							<Trigger Property="IsSelected"
                                     Value="True">

								<Trigger.EnterActions>

									<BeginStoryboard>

										<Storyboard>

											<DoubleAnimation Storyboard.TargetName="SelectedOverlay"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0:0:0.16">

												<DoubleAnimation.EasingFunction>

													<QuinticEase EasingMode="EaseOut"/>

												</DoubleAnimation.EasingFunction>

											</DoubleAnimation>

										</Storyboard>

									</BeginStoryboard>

								</Trigger.EnterActions>

								<Trigger.ExitActions>

									<BeginStoryboard>

										<Storyboard>

											<DoubleAnimation Storyboard.TargetName="SelectedOverlay"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.16">

												<DoubleAnimation.EasingFunction>

													<QuinticEase EasingMode="EaseOut"/>

												</DoubleAnimation.EasingFunction>

											</DoubleAnimation>

										</Storyboard>

									</BeginStoryboard>

								</Trigger.ExitActions>

							</Trigger>

						</ControlTemplate.Triggers>

					</ControlTemplate>

				</Setter.Value>

			</Setter>

		</Style>


		<DataTemplate x:Key="NoteListTemplate">

			<Grid Height="76">

				<Grid.ColumnDefinitions>

					<ColumnDefinition Width="10"/>

					<ColumnDefinition Width="38"/>

					<ColumnDefinition Width="*"/>

					<ColumnDefinition Width="Auto"/>

				</Grid.ColumnDefinitions>


				<Border Grid.Column="0"
                        Width="5"
                        HorizontalAlignment="Center"
                        CornerRadius="3"
                        Background="{Binding Color}"/>


				<CheckBox Grid.Column="1"
                          Width="22"
                          Height="22"
                          VerticalAlignment="Center"
                          IsChecked="{Binding IsCompleted}"
                          IsHitTestVisible="False"/>


				<StackPanel Grid.Column="2"
                            Margin="8,10,8,8"
                            VerticalAlignment="Center">

					<TextBlock Text="{Binding Title}"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}"
                               TextTrimming="CharacterEllipsis"/>


					<TextBlock Text="{Binding Preview}"
                               Margin="0,4,0,0"
                               FontSize="13"
                               FontFamily="{DynamicResource HandwritingFont}"
                               Foreground="{StaticResource TextSecondary}"
                               TextTrimming="CharacterEllipsis"/>

				</StackPanel>


				<StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="8,0,12,0">

					<Border Background="#FFE5E2D9"
                            CornerRadius="9"
                            Padding="8,3"
                            Margin="0,0,8,0">

						<TextBlock Text="{Binding StatusText}"
                                   FontSize="9.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondary}"/>

					</Border>


					<TextBlock Text="{Binding RelativeTime}"
                               FontSize="11"
                               Foreground="{StaticResource TextTertiary}"
                               VerticalAlignment="Center"/>

				</StackPanel>

			</Grid>

		</DataTemplate>


		<Style x:Key="ModernScrollBar"
       TargetType="{x:Type ScrollBar}">

			<Setter Property="Width"
					Value="8"/>

			<Setter Property="Background"
					Value="Transparent"/>

			<Setter Property="Foreground"
					Value="#40808080"/>

			<Setter Property="Template">

				<Setter.Value>

					<ControlTemplate TargetType="{x:Type ScrollBar}">

						<Grid Background="Transparent">

							<Track x:Name="PART_Track"
								   IsDirectionReversed="True">

								<Track.DecreaseRepeatButton>

									<RepeatButton
										Command="{x:Static ScrollBar.PageUpCommand}"
										Background="Transparent"
										BorderThickness="0"
										Focusable="False"
										IsTabStop="False"
										Opacity="0"/>

								</Track.DecreaseRepeatButton>

								<Track.Thumb>

									<Thumb Background="{TemplateBinding Foreground}"
										   BorderThickness="0"
										   Cursor="Hand">

										<Thumb.Template>

											<ControlTemplate TargetType="{x:Type Thumb}">

												<Border x:Name="ThumbBorder"
														Background="{TemplateBinding Background}"
														CornerRadius="4"
														Margin="1,0,1,0"/>

												<ControlTemplate.Triggers>

													<Trigger Property="IsMouseOver"
															 Value="True">

														<Setter TargetName="ThumbBorder"
																Property="Background"
																Value="#60707070"/>

													</Trigger>

													<Trigger Property="IsDragging"
															 Value="True">

														<Setter TargetName="ThumbBorder"
																Property="Background"
																Value="#80707070"/>

													</Trigger>

												</ControlTemplate.Triggers>

											</ControlTemplate>

										</Thumb.Template>

									</Thumb>

								</Track.Thumb>

								<Track.IncreaseRepeatButton>

									<RepeatButton
										Command="{x:Static ScrollBar.PageDownCommand}"
										Background="Transparent"
										BorderThickness="0"
										Focusable="False"
										IsTabStop="False"
										Opacity="0"/>

								</Track.IncreaseRepeatButton>

							</Track>

						</Grid>

					</ControlTemplate>

				</Setter.Value>

			</Setter>

		</Style>


		<!-- Top navigation tab (Notes / Settings) -->
		<Style x:Key="NavTabButton"
               TargetType="{x:Type ToggleButton}">

			<Setter Property="Cursor"
                    Value="Hand"/>

			<Setter Property="Foreground"
                    Value="{StaticResource TextSecondary}"/>

			<Setter Property="FontSize"
                    Value="14"/>

			<Setter Property="FontWeight"
                    Value="SemiBold"/>

			<Setter Property="Template">

				<Setter.Value>

					<ControlTemplate TargetType="{x:Type ToggleButton}">

						<Grid Background="Transparent">

							<Border x:Name="TabBg"
                                    Background="Transparent"
                                    Padding="16,11">

								<ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>

							</Border>

							<Border x:Name="Indicator"
                                    Height="3"
                                    VerticalAlignment="Bottom"
                                    Margin="12,0"
                                    Background="{StaticResource TextPrimary}"
                                    CornerRadius="2"
                                    Opacity="0"/>

						</Grid>

						<ControlTemplate.Triggers>

							<Trigger Property="IsMouseOver"
                                     Value="True">

								<Setter TargetName="TabBg"
                                        Property="Background"
                                        Value="{StaticResource HoverSurface}"/>

							</Trigger>

							<Trigger Property="IsChecked"
                                     Value="True">

								<Setter TargetName="Indicator"
                                        Property="Opacity"
                                        Value="1"/>

								<Setter Property="Foreground"
                                        Value="{StaticResource TextPrimary}"/>

							</Trigger>

						</ControlTemplate.Triggers>

					</ControlTemplate>

				</Setter.Value>

			</Setter>

		</Style>

	</Window.Resources>


	<Grid Background="{StaticResource WindowBackground}">

		<Grid.RowDefinitions>

			<RowDefinition Height="Auto"/>

			<RowDefinition Height="*"/>

		</Grid.RowDefinitions>


		<!-- ================================================= -->
		<!-- TOP NAVIGATION (Notes / Settings)                -->
		<!-- ================================================= -->

		<Border Grid.Row="0"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource SoftBorder}"
                BorderThickness="0,0,0,1"
                Padding="18,6">

			<StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">

				<ToggleButton x:Name="NotesTabButton"
                              Style="{StaticResource NavTabButton}"
                              IsChecked="True"
                              Click="NotesTabButton_Click">

					<StackPanel Orientation="Horizontal">

						<TextBlock Text="All Notes"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,1"/>

					</StackPanel>

				</ToggleButton>

				<ToggleButton x:Name="SettingsTabButton"
                              Style="{StaticResource NavTabButton}"
                              Click="SettingsTabButton_Click">

					<StackPanel Orientation="Horizontal">

						<!-- Gear glyph -->
						<TextBlock Text="&#xE713;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="15"
                                   VerticalAlignment="Center"
                                   Margin="0,-1,8,0"/>

						<TextBlock Text="Settings"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,1"/>

					</StackPanel>

				</ToggleButton>

			</StackPanel>

		</Border>


		<!-- ================================================= -->
		<!-- NOTES VIEW                                       -->
		<!-- ================================================= -->

		<Grid x:Name="NotesView"
              Grid.Row="1">

		<Grid.ColumnDefinitions>

			<ColumnDefinition Width="500"/>

			<ColumnDefinition Width="1"/>

			<ColumnDefinition Width="*"/>

		</Grid.ColumnDefinitions>


		<Grid Grid.Column="0"
              Margin="20,18,16,18">

			<Grid.RowDefinitions>

				<RowDefinition Height="Auto"/>

				<RowDefinition Height="Auto"/>

				<RowDefinition Height="Auto"/>

				<RowDefinition Height="*"/>

			</Grid.RowDefinitions>


			<Grid Grid.Row="0">

				<TextBlock Text="All Notes"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"
                           VerticalAlignment="Center"/>


				<Button x:Name="ImportButton"
                        Content="Import"
                        Style="{StaticResource ToolbarButton}"
                        MinWidth="94"
                        HorizontalAlignment="Right"
                        Click="ImportButton_Click"/>

			</Grid>


			<Grid Grid.Row="1"
                  Margin="0,16,0,10">

				<Border Background="#FFFCFBF8"
                        BorderThickness="1"
                        CornerRadius="13"
                        Height="42">

					<Border.BorderBrush>

						<SolidColorBrush Color="#FFE0DDD4"/>

					</Border.BorderBrush>

					<Border.Style>

						<Style TargetType="{x:Type Border}">

							<Style.Triggers>

								<DataTrigger Binding="{Binding IsKeyboardFocusWithin,
                                                                ElementName=SearchBox}"
                                             Value="True">

									<DataTrigger.EnterActions>

										<BeginStoryboard>

											<Storyboard>

												<ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                To="#FFB9B4A8"
                                                                Duration="0:0:0.16">

													<ColorAnimation.EasingFunction>

														<QuinticEase EasingMode="EaseOut"/>

													</ColorAnimation.EasingFunction>

												</ColorAnimation>

											</Storyboard>

										</BeginStoryboard>

									</DataTrigger.EnterActions>

									<DataTrigger.ExitActions>

										<BeginStoryboard>

											<Storyboard>

												<ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                To="#FFE0DDD4"
                                                                Duration="0:0:0.2">

													<ColorAnimation.EasingFunction>

														<QuinticEase EasingMode="EaseOut"/>

													</ColorAnimation.EasingFunction>

												</ColorAnimation>

											</Storyboard>

										</BeginStoryboard>

									</DataTrigger.ExitActions>

								</DataTrigger>

							</Style.Triggers>

						</Style>

					</Border.Style>

					<Grid>

						<TextBlock Text="Search"
                                   FontSize="13"
                                   Foreground="{StaticResource TextTertiary}"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center"/>


						<TextBox x:Name="SearchBox"
                                 Margin="70,0,66,0"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="14"
                                 Foreground="{StaticResource TextPrimary}"
                                 CaretBrush="{StaticResource TextPrimary}"
                                 VerticalContentAlignment="Center"
                                 TextChanged="SearchBox_TextChanged"/>


						<TextBlock x:Name="CountText"
                                   HorizontalAlignment="Right"
                                   Margin="0,0,14,0"
                                   Foreground="{StaticResource TextTertiary}"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>

					</Grid>

				</Border>

			</Grid>


			<StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        Margin="0,0,0,10">

				<Button x:Name="AllFilterButton"
                        Content="All"
                        Style="{StaticResource FilterButton}"
                        Click="FilterButton_Click"
                        Tag="All"/>


				<Button x:Name="ActiveFilterButton"
                        Content="Active"
                        Style="{StaticResource FilterButton}"
                        Click="FilterButton_Click"
                        Tag="Active"/>


				<Button x:Name="ArchivedFilterButton"
                        Content="Archived"
                        Style="{StaticResource FilterButton}"
                        Click="FilterButton_Click"
                        Tag="Archived"/>

			</StackPanel>


			<ListBox x:Name="NotesList"
					 Grid.Row="3"
					 ItemsSource="{Binding FilteredNotes}"
					 ItemTemplate="{StaticResource NoteListTemplate}"
					 ItemContainerStyle="{StaticResource NoteListItemStyle}"
					 SelectionChanged="NotesList_SelectionChanged"
					 MouseDoubleClick="NotesList_MouseDoubleClick"
					 Background="Transparent"
					 BorderThickness="0"
					 Padding="0"
					 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
					 ScrollViewer.VerticalScrollBarVisibility="Auto">

				<ListBox.Resources>

					<Style TargetType="{x:Type ScrollBar}"
						   BasedOn="{StaticResource ModernScrollBar}"/>

				</ListBox.Resources>

			</ListBox>
		</Grid>


		<Border Grid.Column="1"
                Background="#FFE4E1D8"/>


		<Grid Grid.Column="2"
              Margin="24,22,24,22">

			<Grid.RowDefinitions>

				<RowDefinition Height="Auto"/>

				<RowDefinition Height="*"/>

			</Grid.RowDefinitions>


			<Grid Grid.Row="0"
                  Margin="0,0,0,16">

				<StackPanel Orientation="Horizontal">

					<Border Background="#FFD7E8F7"
                            CornerRadius="6"
                            Width="11"
                            Height="11"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0"/>


					<StackPanel>

						<TextBlock Text="ACTIVE · IN"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondary}"/>


						<TextBlock Text="THE DECK"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondary}"/>

					</StackPanel>

				</StackPanel>


				<StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">

					<Button x:Name="MarkCompleteButton"
                            Content="Mark complete"
                            Style="{StaticResource ToolbarButton}"
                            MinWidth="112"
                            Click="MarkCompleteButton_Click"/>


					<Button x:Name="ExportButton"
                            Content="Export"
                            Style="{StaticResource ToolbarButton}"
                            MinWidth="82"
                            Click="ExportButton_Click"/>


					<Button x:Name="DeleteButton"
                            Content="Delete"
                            Style="{StaticResource DangerButton}"
                            MinWidth="76"
                            Click="DeleteButton_Click"/>

				</StackPanel>

			</Grid>


			<Border x:Name="DetailCard"
                    Grid.Row="1"
                    Background="#FFB9D8F8"
                    CornerRadius="24"
                    Padding="24">

				<Grid>

					<Grid.RowDefinitions>

						<RowDefinition Height="Auto"/>

						<RowDefinition Height="*"/>

						<RowDefinition Height="Auto"/>

					</Grid.RowDefinitions>


					<Grid Grid.Row="0">

						<TextBlock x:Name="DetailTitle"
                                   FontSize="23"
                                   FontWeight="Bold"
                                   Foreground="#FF20252A"
                                   TextTrimming="CharacterEllipsis"/>


						<TextBlock x:Name="DetailTime"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontSize="11.5"
                                   Foreground="#FF607991"/>

					</Grid>


					<ScrollViewer Grid.Row="1"
								  Margin="0,18,0,18"
								  VerticalScrollBarVisibility="Auto"
								  HorizontalScrollBarVisibility="Disabled">

						<ScrollViewer.Resources>
							<Style TargetType="{x:Type ScrollBar}"
								   BasedOn="{StaticResource ModernScrollBar}"/>
						</ScrollViewer.Resources>

						<TextBlock x:Name="DetailContent"
								   FontFamily="{DynamicResource HandwritingFont}"
								   FontSize="20"
								   LineHeight="31"
								   Foreground="#FF26313B"
								   TextWrapping="Wrap"/>

					</ScrollViewer>


					<Grid Grid.Row="2">

						<Border Height="1"
                                VerticalAlignment="Top"
                                Background="#40809AB3"/>


						<TextBlock x:Name="DetailMeta"
                                   Margin="0,14,0,0"
                                   FontSize="11.5"
                                   Foreground="#FF607991"/>

					</Grid>

				</Grid>

			</Border>

		</Grid>

		</Grid><!-- /NotesView -->


		<!-- ================================================= -->
		<!-- SETTINGS VIEW                                     -->
		<!-- ================================================= -->

		<views:SettingsPanel x:Name="SettingsView"
                             Grid.Row="1"
                             Visibility="Collapsed"
                             Margin="24,18,0,0"/>

	</Grid>

</Window>