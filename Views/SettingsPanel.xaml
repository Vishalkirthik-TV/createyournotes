<UserControl x:Class="HoldMyNotes.Views.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <UserControl.Resources>

        <SolidColorBrush x:Key="SpTextPrimary"
                         Color="#FF302F2C"/>

        <SolidColorBrush x:Key="SpTextSecondary"
                         Color="#FF74716A"/>

        <SolidColorBrush x:Key="SpTextTertiary"
                         Color="#FF97938A"/>

        <SolidColorBrush x:Key="SpCardBackground"
                         Color="#FFFCFBF8"/>

        <SolidColorBrush x:Key="SpCardBorder"
                         Color="#FFE0DDD4"/>

        <SolidColorBrush x:Key="SpAccent"
                         Color="#FF4A6B8A"/>


        <!-- Section heading -->
        <Style x:Key="SpSectionTitle"
               TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize"
                    Value="15"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Foreground"
                    Value="{StaticResource SpTextPrimary}"/>
            <Setter Property="Margin"
                    Value="0,0,0,2"/>
        </Style>


        <Style x:Key="SpSectionHint"
               TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize"
                    Value="12.5"/>
            <Setter Property="Foreground"
                    Value="{StaticResource SpTextSecondary}"/>
            <Setter Property="TextWrapping"
                    Value="Wrap"/>
            <Setter Property="Margin"
                    Value="0,0,0,14"/>
        </Style>


        <!-- Rounded pill button -->
        <Style x:Key="SpButton"
               TargetType="{x:Type Button}">
            <Setter Property="Height"
                    Value="38"/>
            <Setter Property="MinWidth"
                    Value="96"/>
            <Setter Property="Padding"
                    Value="16,0"/>
            <Setter Property="Margin"
                    Value="8,0,0,0"/>
            <Setter Property="Background"
                    Value="#FFEAE8DF"/>
            <Setter Property="BorderBrush"
                    Value="{StaticResource SpCardBorder}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Foreground"
                    Value="{StaticResource SpTextPrimary}"/>
            <Setter Property="FontSize"
                    Value="13"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11">
                            <Grid>
                                <Border x:Name="HoverOverlay"
                                        Background="#FFDDDAD0"
                                        CornerRadius="11"
                                        Opacity="0"/>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0:0:0.14">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuinticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuinticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HoverOverlay" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Primary accent button -->
        <Style x:Key="SpAccentButton"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource SpButton}">
            <Setter Property="Background"
                    Value="#FF4A6B8A"/>
            <Setter Property="BorderBrush"
                    Value="#FF3E5C77"/>
            <Setter Property="Foreground"
                    Value="#FFFFFFFF"/>
        </Style>


        <!-- Hex input box -->
        <Style x:Key="SpInput"
               TargetType="{x:Type TextBox}">
            <Setter Property="Height"
                    Value="38"/>
            <Setter Property="Padding"
                    Value="12,0"/>
            <Setter Property="FontSize"
                    Value="13"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
            <Setter Property="Foreground"
                    Value="{StaticResource SpTextPrimary}"/>
            <Setter Property="CaretBrush"
                    Value="{StaticResource SpTextPrimary}"/>
            <Setter Property="Background"
                    Value="#FFFFFFFF"/>
            <Setter Property="BorderBrush"
                    Value="{StaticResource SpCardBorder}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
        </Style>


        <!-- ComboBox -->
        <Style x:Key="SpCombo"
               TargetType="{x:Type ComboBox}">
            <Setter Property="Height"
                    Value="38"/>
            <Setter Property="Padding"
                    Value="10,0"/>
            <Setter Property="FontSize"
                    Value="13"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
            <Setter Property="Foreground"
                    Value="{StaticResource SpTextPrimary}"/>
            <Setter Property="Background"
                    Value="#FFFFFFFF"/>
            <Setter Property="BorderBrush"
                    Value="{StaticResource SpCardBorder}"/>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel MaxWidth="640"
                    HorizontalAlignment="Left"
                    Margin="0,4,24,24">

            <TextBlock Text="Settings"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{StaticResource SpTextPrimary}"
                       Margin="0,0,0,20"/>


            <!-- ============================================= -->
            <!-- GLOBAL HOTKEY                                 -->
            <!-- ============================================= -->
            <Border Background="{StaticResource SpCardBackground}"
                    BorderBrush="{StaticResource SpCardBorder}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="22,20">

                <StackPanel>

                    <TextBlock Text="Open All Notes hotkey"
                               Style="{StaticResource SpSectionTitle}"/>

                    <TextBlock Style="{StaticResource SpSectionHint}"
                               Text="Press a shortcut to open the All Notes view from anywhere. Click the field, then press your keys (for example Ctrl+Shift+N). Choose None to disable."/>

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="HotkeyBox"
                                 Grid.Column="0"
                                 Style="{StaticResource SpInput}"
                                 IsReadOnly="True"
                                 IsReadOnlyCaretVisible="False"
                                 Background="#FFF3F1EA"
                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                 GotKeyboardFocus="HotkeyBox_GotKeyboardFocus"
                                 PreviewMouseDown="HotkeyBox_PreviewMouseDown"/>


                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Margin="8,0,0,0">

                            <Button Content="None"
                                    Style="{StaticResource SpButton}"
                                    Click="HotkeyNone_Click"/>

                            <Button Content="Save"
                                    Style="{StaticResource SpAccentButton}"
                                    Click="HotkeySave_Click"/>

                        </StackPanel>

                    </Grid>

                    <TextBlock x:Name="HotkeyStatus"
                               Margin="0,10,0,0"
                               FontSize="12"
                               Foreground="{StaticResource SpTextSecondary}"/>

                </StackPanel>

            </Border>


            <!-- ============================================= -->
            <!-- FONTS                                         -->
            <!-- ============================================= -->
            <Border Background="{StaticResource SpCardBackground}"
                    BorderBrush="{StaticResource SpCardBorder}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="22,20"
                    Margin="0,16,0,0">

                <StackPanel>

                    <TextBlock Text="Fonts"
                               Style="{StaticResource SpSectionTitle}"/>

                    <TextBlock Style="{StaticResource SpSectionHint}"
                               Text="Choose the handwriting font used for note bodies and previews, and the UI font used for headings and controls."/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Handwriting"
                                       FontSize="12"
                                       Foreground="{StaticResource SpTextSecondary}"
                                       Margin="2,0,0,6"/>
                            <ComboBox x:Name="HandwritingCombo"
                                      Style="{StaticResource SpCombo}"
                                      SelectionChanged="HandwritingCombo_SelectionChanged"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="User interface"
                                       FontSize="12"
                                       Foreground="{StaticResource SpTextSecondary}"
                                       Margin="2,0,0,6"/>
                            <ComboBox x:Name="UiCombo"
                                      Style="{StaticResource SpCombo}"
                                      SelectionChanged="UiCombo_SelectionChanged"/>
                        </StackPanel>
                    </Grid>

                    <!-- Live preview -->
                    <Border Background="#FFFFF7DB"
                            CornerRadius="12"
                            Padding="16,14"
                            Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Preview"
                                       FontSize="11"
                                       Foreground="#FF9A8B4E"
                                       Margin="0,0,0,4"/>
                            <TextBlock x:Name="PreviewHandwriting"
                                       Text="understand all the apis listed"
                                       FontSize="18"
                                       Foreground="#FF26313B"/>
                            <TextBlock x:Name="PreviewUi"
                                       Text="Groceries"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="#FF20252A"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                </StackPanel>

            </Border>


            <!-- ============================================= -->
            <!-- NOTE COLORS                                   -->
            <!-- ============================================= -->
            <Border Background="{StaticResource SpCardBackground}"
                    BorderBrush="{StaticResource SpCardBorder}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="22,20"
                    Margin="0,16,0,0">

                <StackPanel>

                    <TextBlock Text="Note colors"
                               Style="{StaticResource SpSectionTitle}"/>

                    <TextBlock Style="{StaticResource SpSectionHint}"
                               Text="Add extra colors to the palette used when creating a note. The five default colors are always available."/>

                    <!-- Current palette -->
                    <WrapPanel x:Name="PalettePanel"
                               Margin="0,0,0,16"/>

                    <!-- Add color row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="NewColorPreview"
                                Grid.Column="0"
                                Width="38"
                                Height="38"
                                CornerRadius="9"
                                Background="#FFFFD75A"
                                VerticalAlignment="Top"
                                BorderBrush="{StaticResource SpCardBorder}"
                                BorderThickness="1"/>

                        <TextBox x:Name="HexBox"
                                 Grid.Column="2"
                                 Style="{StaticResource SpInput}"
                                 Text="#FFFFD75A"
                                 MaxLength="9"
                                 VerticalAlignment="Top"/>

                        <Button Grid.Column="3"
                                Content="Pick"
                                Style="{StaticResource SpButton}"
                                VerticalAlignment="Top"
                                Click="PickColor_Click"/>

                        <Button Grid.Column="4"
                                Content="Add"
                                Style="{StaticResource SpAccentButton}"
                                VerticalAlignment="Top"
                                Click="AddColor_Click"/>
                    </Grid>

                    <TextBlock x:Name="ColorStatus"
                               Margin="0,10,0,0"
                               FontSize="12"
                               Foreground="{StaticResource SpTextSecondary}"/>

                </StackPanel>

            </Border>

        </StackPanel>

    </ScrollViewer>

</UserControl>
