<Window x:Class="HoldMyNotes.EdgeRailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="360"
        Height="720">

    <Grid Background="Transparent"
          ClipToBounds="False">

        <Canvas x:Name="RootCanvas"
                Width="360"
                Height="720"
                ClipToBounds="False">

            <!-- ================================================= -->
            <!-- DYNAMIC FAN-OUT TABS                              -->
            <!-- ================================================= -->

            <Canvas x:Name="TabCanvas"
                    Width="360"
                    Height="720"
                    ClipToBounds="False"
                    Panel.ZIndex="200"/>


            <!-- ================================================= -->
            <!-- RESTING GREY RAIL                                -->
            <!-- ================================================= -->

            <Border x:Name="Rail"
                    Width="14"
                    Height="112"
                    Background="#FF3D3D3D"
                    CornerRadius="7,0,0,7"
                    Canvas.Left="346"
                    Canvas.Top="304"
                    Panel.ZIndex="100"/>


            <!-- ================================================= -->
            <!-- RESTING COLOURED PILLS                           -->
            <!-- ================================================= -->

            <StackPanel x:Name="IndicatorStack"
                        Width="14"
                        Canvas.Left="346"
                        Canvas.Top="310"
                        HorizontalAlignment="Center"
                        Panel.ZIndex="110"/>


            <!-- ================================================= -->
            <!-- ADD BUTTON                                        -->
            <!-- ONLY VISIBLE DURING FAN-OUT                      -->
            <!-- ================================================= -->

            <Button x:Name="AddButton"
                    Width="30"
                    Height="30"
                    Canvas.Left="330"
                    Canvas.Top="660"
                    Visibility="Collapsed"
                    Panel.ZIndex="500"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    Cursor="Hand"
                    ToolTip="Add note">

                <Button.Template>

                    <ControlTemplate TargetType="Button">

                        <Grid x:Name="AddRoot"
                              RenderTransformOrigin="0.5,0.5">

                            <Grid.RenderTransform>

                                <ScaleTransform ScaleX="1"
                                                ScaleY="1"/>

                            </Grid.RenderTransform>

                            <Ellipse x:Name="AddCircle"
                                     Fill="#FFFFFFFF"
                                     Stroke="#FFE2E0D9"
                                     StrokeThickness="1">

                                <Ellipse.Effect>

                                    <DropShadowEffect BlurRadius="14"
                                                      ShadowDepth="2"
                                                      Direction="270"
                                                      Opacity="0.2"/>

                                </Ellipse.Effect>

                            </Ellipse>

                            <TextBlock Text="+"
                                       FontFamily="Segoe UI"
                                       FontSize="20"
                                       FontWeight="Light"
                                       Foreground="#FF4A4845"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,-1,0,0"/>

                        </Grid>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Trigger.EnterActions>

                                    <BeginStoryboard>

                                        <Storyboard>

                                            <DoubleAnimation Storyboard.TargetName="AddRoot"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.12"
                                                             Duration="0:0:0.16">

                                                <DoubleAnimation.EasingFunction>

                                                    <QuinticEase EasingMode="EaseOut"/>

                                                </DoubleAnimation.EasingFunction>

                                            </DoubleAnimation>

                                            <DoubleAnimation Storyboard.TargetName="AddRoot"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.12"
                                                             Duration="0:0:0.16">

                                                <DoubleAnimation.EasingFunction>

                                                    <QuinticEase EasingMode="EaseOut"/>

                                                </DoubleAnimation.EasingFunction>

                                            </DoubleAnimation>

                                        </Storyboard>

                                    </BeginStoryboard>

                                </Trigger.EnterActions>

                                <Trigger.ExitActions>

                                    <BeginStoryboard>

                                        <Storyboard>

                                            <DoubleAnimation Storyboard.TargetName="AddRoot"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1"
                                                             Duration="0:0:0.2">

                                                <DoubleAnimation.EasingFunction>

                                                    <QuinticEase EasingMode="EaseOut"/>

                                                </DoubleAnimation.EasingFunction>

                                            </DoubleAnimation>

                                            <DoubleAnimation Storyboard.TargetName="AddRoot"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1"
                                                             Duration="0:0:0.2">

                                                <DoubleAnimation.EasingFunction>

                                                    <QuinticEase EasingMode="EaseOut"/>

                                                </DoubleAnimation.EasingFunction>

                                            </DoubleAnimation>

                                        </Storyboard>

                                    </BeginStoryboard>

                                </Trigger.ExitActions>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Trigger.EnterActions>

                                    <BeginStoryboard>

                                        <Storyboard>

                                            <DoubleAnimation Storyboard.TargetName="AddRoot"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="0.92"
                                                             Duration="0:0:0.07"/>

                                            <DoubleAnimation Storyboard.TargetName="AddRoot"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="0.92"
                                                             Duration="0:0:0.07"/>

                                        </Storyboard>

                                    </BeginStoryboard>

                                </Trigger.EnterActions>

                                <Trigger.ExitActions>

                                    <BeginStoryboard>

                                        <Storyboard>

                                            <DoubleAnimation Storyboard.TargetName="AddRoot"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.12"
                                                             Duration="0:0:0.14">

                                                <DoubleAnimation.EasingFunction>

                                                    <QuinticEase EasingMode="EaseOut"/>

                                                </DoubleAnimation.EasingFunction>

                                            </DoubleAnimation>

                                            <DoubleAnimation Storyboard.TargetName="AddRoot"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.12"
                                                             Duration="0:0:0.14">

                                                <DoubleAnimation.EasingFunction>

                                                    <QuinticEase EasingMode="EaseOut"/>

                                                </DoubleAnimation.EasingFunction>

                                            </DoubleAnimation>

                                        </Storyboard>

                                    </BeginStoryboard>

                                </Trigger.ExitActions>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Button.Template>

            </Button>

        </Canvas>

    </Grid>

</Window>