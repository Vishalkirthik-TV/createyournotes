<Window x:Class="HoldMyNotes.EdgeRailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="220"
        Height="620">

    <Grid x:Name="RootGrid"
          Background="Transparent"
          ClipToBounds="False">

        <Canvas x:Name="RootCanvas"
                Width="220"
                Height="620"
                ClipToBounds="False">

            <!-- Dynamic note tabs/cards -->
            <Canvas x:Name="TabCanvas"
                    Width="220"
                    Height="620"
                    ClipToBounds="False"
                    Panel.ZIndex="20"/>

            <!-- Resting-state rail -->
            <Border x:Name="Rail"
                    Width="14"
                    Height="104"
                    Background="#FF4A4A4A"
                    CornerRadius="7,0,0,7"
                    Canvas.Left="206"
                    Canvas.Top="258"
                    Panel.ZIndex="100"/>

            <!-- Colored note indicators -->
            <StackPanel x:Name="IndicatorStack"
                        Width="14"
                        Canvas.Left="206"
                        Canvas.Top="267"
                        HorizontalAlignment="Center"
                        Panel.ZIndex="110"/>

            <!-- Add button: visible only in fan-out -->
            <Button x:Name="AddButton"
                    Width="30"
                    Height="30"
                    Canvas.Left="190"
                    Canvas.Top="530"
                    Visibility="Collapsed"
                    Panel.ZIndex="300"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    Cursor="Hand"
                    ToolTip="Add note">

                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Fill="#FFF1F1F1"
                                     Stroke="#FFD8D8D8"
                                     StrokeThickness="1"/>
                            <TextBlock Text="+"
                                       FontFamily="Segoe UI"
                                       FontSize="20"
                                       FontWeight="Normal"
                                       Foreground="#FF555555"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,-2,0,0"/>
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
            </Button>

        </Canvas>
    </Grid>
</Window>
