<Window x:Class="HoldMyNotes.EdgeRailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="360"
        Height="720">

    <Grid Background="Transparent"
          ClipToBounds="False">

        <Canvas x:Name="RootCanvas"
                Width="360"
                Height="720"
                ClipToBounds="False">

            <!-- ================================================= -->
            <!-- DYNAMIC FAN-OUT TABS                              -->
            <!-- ================================================= -->

            <Canvas x:Name="TabCanvas"
                    Width="360"
                    Height="720"
                    ClipToBounds="False"
                    Panel.ZIndex="200"/>


            <!-- ================================================= -->
            <!-- RESTING GREY RAIL                                -->
            <!-- ================================================= -->

            <Border x:Name="Rail"
                    Width="14"
                    Height="112"
                    Background="#FF3D3D3D"
                    CornerRadius="7,0,0,7"
                    Canvas.Left="346"
                    Canvas.Top="304"
                    Panel.ZIndex="100"/>


            <!-- ================================================= -->
            <!-- RESTING COLOURED PILLS                           -->
            <!-- ================================================= -->

            <StackPanel x:Name="IndicatorStack"
                        Width="14"
                        Canvas.Left="346"
                        Canvas.Top="310"
                        HorizontalAlignment="Center"
                        Panel.ZIndex="110"/>


            <!-- ================================================= -->
            <!-- ADD BUTTON                                        -->
            <!-- ONLY VISIBLE DURING FAN-OUT                      -->
            <!-- ================================================= -->

            <Button x:Name="AddButton"
                    Width="30"
                    Height="30"
                    Canvas.Left="330"
                    Canvas.Top="660"
                    Visibility="Collapsed"
                    Panel.ZIndex="500"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    Cursor="Hand"
                    ToolTip="Add note">

                <Button.Template>

                    <ControlTemplate TargetType="Button">

                        <Grid>

                            <Ellipse Fill="#FFF1F1F1"
                                     Stroke="#FFD0D0D0"
                                     StrokeThickness="1"/>

                            <TextBlock Text="+"
                                       FontFamily="Segoe UI"
                                       FontSize="20"
                                       Foreground="#FF454545"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,-2,0,0"/>

                        </Grid>

                    </ControlTemplate>

                </Button.Template>

            </Button>

        </Canvas>

    </Grid>

</Window>