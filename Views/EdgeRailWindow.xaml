<Window x:Class="HoldMyNotes.EdgeRailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Width="220"
        Height="500"
        ResizeMode="NoResize">

    <Grid>
        <Canvas x:Name="RootCanvas"
                Width="220"
                Height="500"
                ClipToBounds="False">

            <!-- Dynamic fan-out tabs. -->
            <Canvas x:Name="TabCanvas"
                    Width="220"
                    Height="500"
                    ClipToBounds="False"
                    Panel.ZIndex="20"/>

            <!-- Resting grey rail. -->
            <Border x:Name="Rail"
                    Width="20"
                    Height="112"
                    Canvas.Left="200"
                    Canvas.Top="150"
                    Background="#FF393939"
                    CornerRadius="10"
                    Panel.ZIndex="100"/>

            <!-- One colored pill for every note. -->
            <StackPanel x:Name="IndicatorStack"
                        Width="20"
                        Canvas.Left="200"
                        Canvas.Top="157"
                        Panel.ZIndex="110"
                        IsHitTestVisible="False"/>

            <!-- Visible only in fan-out state. -->
            <Button x:Name="AddButton"
                    Width="30"
                    Height="30"
                    Canvas.Left="187"
                    Canvas.Top="360"
                    Visibility="Collapsed"
                    Panel.ZIndex="300"
                    BorderThickness="0"
                    Background="Transparent"
                    Cursor="Hand"
                    ToolTip="Add note">

                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Fill="#FFE9E9E9"
                                     Stroke="#FFD0D0D0"
                                     StrokeThickness="1"/>

                            <TextBlock Text="+"
                                       FontSize="20"
                                       Foreground="#FF444444"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,-2,0,0"/>
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
            </Button>

        </Canvas>
    </Grid>
</Window>
