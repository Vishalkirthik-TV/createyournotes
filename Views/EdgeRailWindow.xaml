<Window x:Class="HoldMyNotes.Views.EdgeRailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Width="220"
        Height="360"
        ResizeMode="NoResize"
        ShowActivated="False">

    <Grid>

        <Canvas x:Name="TabCanvas"
                ClipToBounds="False">

            <!-- ================================================= -->
            <!-- NOTE CARDS -->
            <!-- ================================================= -->

            <!--
                Cards are created dynamically in C#.

                Closed:
                    cards are at Canvas.Left = 202
                    therefore they are underneath the rail.

                Open:
                    cards move left to Canvas.Left = 50
                    and become fully visible.
            -->


            <!-- ================================================= -->
            <!-- DYNAMIC GREY RAIL -->
            <!-- ================================================= -->

            <Border x:Name="Rail"
                    Width="18"
                    MinHeight="112"
                    Height="112"
                    Background="#FF3A3A3A"
                    CornerRadius="9"
                    Canvas.Left="202"
                    Canvas.Top="95"
                    Panel.ZIndex="100"
                    Opacity="1"/>


            <!-- ================================================= -->
            <!-- DYNAMIC COLOURED PILLS -->
            <!-- ================================================= -->

            <!--
                This is intentionally EMPTY.

                EdgeRailWindow.xaml.cs creates one pill
                for every note currently stored in SQLite.
            -->

            <StackPanel x:Name="IndicatorStack"
                        Width="18"
                        Canvas.Left="207"
                        Canvas.Top="104"
                        Panel.ZIndex="110"
                        Opacity="1"/>


            <!-- ================================================= -->
            <!-- ADD BUTTON -->
            <!-- ================================================= -->

            <Button x:Name="AddButton"
                    Width="24"
                    Height="24"
                    Canvas.Left="198"
                    Canvas.Top="220"
                    Content="+"
                    FontSize="15"
                    Padding="0"
                    BorderThickness="0"
                    Background="#FFE8E8E8"
                    Foreground="#FF555555"
                    Panel.ZIndex="200"
                    Visibility="Visible">

                <Button.Template>

                    <ControlTemplate TargetType="Button">

                        <Grid>

                            <Ellipse Fill="#FFE8E8E8"/>

                            <TextBlock Text="+"
                                       FontSize="15"
                                       Foreground="#FF555555"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,-1,0,0"/>

                        </Grid>

                    </ControlTemplate>

                </Button.Template>

            </Button>

        </Canvas>

    </Grid>

</Window>