<Window x:Class="HoldMyNotes.Views.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        ResizeMode="CanResize"
        Width="520"
        Height="560"
        MinWidth="400"
        MinHeight="400"
        WindowStartupLocation="CenterScreen">

    <Border x:Name="NoteSurface"
            Background="#FFDCCBFF"
            CornerRadius="20">

        <Border.Effect>
            <DropShadowEffect
                BlurRadius="25"
                ShadowDepth="5"
                Opacity="0.22"/>
        </Border.Effect>


        <Grid Margin="20">

            <Grid.RowDefinitions>

                <RowDefinition Height="48"/>

                <RowDefinition Height="1"/>

                <RowDefinition Height="*"/>

                <RowDefinition Height="60"/>

            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- HEADER -->
            <!-- ================================================= -->

            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <!-- Title -->

                <TextBox x:Name="TitleTextBox"
                         Grid.Column="0"
                         Text="New Note"
                         Background="Transparent"
                         BorderThickness="0"
                         FontSize="20"
                         FontWeight="SemiBold"
                         Foreground="#FF29252F"
                         VerticalContentAlignment="Center"
                         Padding="0"
                         Margin="4,0,10,0"/>


                <!-- ================================================= -->
                <!-- CLOSE X -->
                <!-- ================================================= -->

                <Button x:Name="CloseWindowButton"
                        Grid.Column="1"
                        Width="34"
                        Height="34"
                        Content="×"
                        FontSize="24"
                        FontWeight="Light"
                        Foreground="#FF5F5868"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="CloseWindowButton_Click"/>

            </Grid>


            <!-- ================================================= -->
            <!-- SEPARATOR -->
            <!-- ================================================= -->

            <Border Grid.Row="1"
                    Background="#30FFFFFF"/>


            <!-- ================================================= -->
            <!-- CONTENT -->
            <!-- ================================================= -->

            <TextBox x:Name="ContentTextBox"
                     Grid.Row="2"
                     Margin="4,16,4,8"
                     Background="Transparent"
                     BorderThickness="0"
                     FontSize="20"
                     Foreground="#FF29252F"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     SpellCheck.IsEnabled="True"/>


            <!-- ================================================= -->
            <!-- FOOTER -->
            <!-- ================================================= -->

            <Grid Grid.Row="3">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <!-- ================================================= -->
                <!-- COLORS -->
                <!-- ================================================= -->

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Button x:Name="YellowButton"
                            Tag="#FFFFD75A"
                            Width="26"
                            Height="26"
                            Margin="0,0,8,0"
                            Background="#FFFFD75A"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="ColorButton_Click"/>

                    <Button x:Name="CoralButton"
                            Tag="#FFFFA98F"
                            Width="26"
                            Height="26"
                            Margin="0,0,8,0"
                            Background="#FFFFA98F"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="ColorButton_Click"/>

                    <Button x:Name="GreenButton"
                            Tag="#FF9CDBA2"
                            Width="26"
                            Height="26"
                            Margin="0,0,8,0"
                            Background="#FF9CDBA2"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="ColorButton_Click"/>

                    <Button x:Name="BlueButton"
                            Tag="#FF9BCFEA"
                            Width="26"
                            Height="26"
                            Margin="0,0,8,0"
                            Background="#FF9BCFEA"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="ColorButton_Click"/>

                    <Button x:Name="PurpleButton"
                            Tag="#FFD0B9F2"
                            Width="26"
                            Height="26"
                            Background="#FFD0B9F2"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="ColorButton_Click"/>

                </StackPanel>


                <!-- ================================================= -->
                <!-- DELETE -->
                <!-- ================================================= -->

                <Button x:Name="DeleteButton"
                        Grid.Column="1"
                        Content="Delete"
                        Width="70"
                        Height="34"
                        Margin="8,0,6,0"
                        Background="#18FFFFFF"
                        BorderThickness="0"
                        Foreground="#FFB54848"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="DeleteButton_Click"/>


                <!-- ================================================= -->
                <!-- COMPLETE -->
                <!-- ================================================= -->

                <Button x:Name="CompleteButton"
                        Grid.Column="2"
                        Content="Mark complete"
                        Width="110"
                        Height="34"
                        Margin="0,0,6,0"
                        Background="#18FFFFFF"
                        BorderThickness="0"
                        Foreground="#FF68616F"
                        Cursor="Hand"
                        Click="CompleteButton_Click"/>


                <!-- ================================================= -->
                <!-- SAVE -->
                <!-- ================================================= -->

                <Button x:Name="SaveButton"
                        Grid.Column="3"
                        Content="Save"
                        Width="68"
                        Height="34"
                        Background="#30FFFFFF"
                        BorderThickness="0"
                        Foreground="#FF4E4655"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="SaveButton_Click"/>

            </Grid>

        </Grid>

    </Border>

</Window>