<Window x:Class="HoldMyNotes.Views.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="430"
        Height="455"
        MinWidth="380"
        MinHeight="380"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <Style x:Key="ColorButtonStyle"
               TargetType="{x:Type Button}">

            <Setter Property="Width"
                    Value="22"/>

            <Setter Property="Height"
                    Value="22"/>

            <Setter Property="Padding"
                    Value="0"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="BorderBrush"
                    Value="Transparent"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
                        BlurRadius="6"
                        ShadowDepth="2"
                        Direction="270"
                        Opacity="0.22"/>
                </Setter.Value>
            </Setter>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border x:Name="ColorBorder"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                SnapsToDevicePixels="True"/>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ColorBorder"
                                        Property="Opacity"
                                        Value="0.82"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ColorBorder"
                                        Property="Opacity"
                                        Value="0.65"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="ColorBorder"
                                        Property="Opacity"
                                        Value="0.35"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <Style x:Key="FooterButtonStyle"
               TargetType="{x:Type Button}">

            <Setter Property="Height"
                    Value="36"/>

            <Setter Property="Padding"
                    Value="14,0"/>

            <Setter Property="Background"
                    Value="#35FFFFFF"/>

            <Setter Property="Foreground"
                    Value="#FF4D4852"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontFamily"
                    Value="Segoe UI"/>

            <Setter Property="FontSize"
                    Value="12.5"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border x:Name="FooterBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="11"
                                SnapsToDevicePixels="True">

                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="FooterBorder"
                                        Property="Background"
                                        Value="#55FFFFFF"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="FooterBorder"
                                        Property="Background"
                                        Value="#70FFFFFF"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="FooterBorder"
                                        Property="Opacity"
                                        Value="0.35"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <Style x:Key="DeleteButtonStyle"
               TargetType="{x:Type Button}">

            <Setter Property="Width"
                    Value="72"/>

            <Setter Property="Height"
                    Value="36"/>

            <Setter Property="Padding"
                    Value="10,0"/>

            <Setter Property="Background"
                    Value="#22FFFFFF"/>

            <Setter Property="Foreground"
                    Value="#FFAA4A4A"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontFamily"
                    Value="Segoe UI"/>

            <Setter Property="FontSize"
                    Value="12.5"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border x:Name="DeleteBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="11"
                                SnapsToDevicePixels="True">

                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="DeleteBorder"
                                        Property="Background"
                                        Value="#40FFB0B0"/>

                                <Setter Property="Foreground"
                                        Value="#FF8D3535"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="DeleteBorder"
                                        Property="Background"
                                        Value="#55FF9C9C"/>

                                <Setter Property="Foreground"
                                        Value="#FF742525"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="DeleteBorder"
                                        Property="Opacity"
                                        Value="0.25"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <Style x:Key="CompleteButtonStyle"
               TargetType="{x:Type Button}">

            <Setter Property="Width"
                    Value="112"/>

            <Setter Property="Height"
                    Value="36"/>

            <Setter Property="Padding"
                    Value="14,0"/>

            <Setter Property="Background"
                    Value="#40FFFFFF"/>

            <Setter Property="Foreground"
                    Value="#FF4B4650"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontFamily"
                    Value="Segoe UI"/>

            <Setter Property="FontSize"
                    Value="12.5"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border x:Name="CompleteBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#18000000"
                                BorderThickness="1"
                                CornerRadius="11"
                                SnapsToDevicePixels="True">

                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="CompleteBorder"
                                        Property="Background"
                                        Value="#62FFFFFF"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="CompleteBorder"
                                        Property="Background"
                                        Value="#78FFFFFF"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="CompleteBorder"
                                        Property="Opacity"
                                        Value="0.35"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <Style x:Key="CloseButtonStyle"
               TargetType="{x:Type Button}">

            <Setter Property="Width"
                    Value="30"/>

            <Setter Property="Height"
                    Value="30"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="#FF625C68"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border x:Name="CloseBorder"
                                Background="Transparent"
                                CornerRadius="9">

                            <TextBlock Text="X"
                                       FontFamily="Segoe UI"
                                       FontSize="14"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="CloseBorder"
                                        Property="Background"
                                        Value="#25FFFFFF"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="CloseBorder"
                                        Property="Background"
                                        Value="#40FFFFFF"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>


    <Border x:Name="NoteSurface"
            Background="#FFDCCBFF"
            CornerRadius="20"
            SnapsToDevicePixels="True">

        <Border.Effect>

            <DropShadowEffect
                BlurRadius="22"
                ShadowDepth="4"
                Direction="270"
                Opacity="0.18"/>

        </Border.Effect>


        <Grid Margin="18">

            <Grid.RowDefinitions>

                <RowDefinition Height="48"/>

                <RowDefinition Height="1"/>

                <RowDefinition Height="*"/>

                <RowDefinition Height="1"/>

                <RowDefinition Height="54"/>

            </Grid.RowDefinitions>


            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <TextBox x:Name="TitleTextBox"
                         Grid.Column="0"
                         Text="New Note"
                         Background="Transparent"
                         BorderThickness="0"
                         FontFamily="Inter"
                         FontSize="20"
                         FontWeight="SemiBold"
                         Foreground="#FF2D2933"
                         VerticalContentAlignment="Center"
                         Padding="0"
                         Margin="4,0,8,0"/>


                <TextBlock x:Name="AutoSaveStatusText"
                           Grid.Column="1"
                           Text="Saved"
                           FontFamily="Segoe UI"
                           FontWeight="Bold"
                           FontSize="11"
                           Foreground="#80615B68"
                           VerticalAlignment="Center"
                           Margin="0,0,4,0"/>


                <Button x:Name="CloseWindowButton"
                        Grid.Column="2"
                        Style="{StaticResource CloseButtonStyle}"
                        Click="CloseWindowButton_Click"/>

            </Grid>


            <Border Grid.Row="1"
                    Height="1"
                    Background="#FF000000"
                    Opacity="0.12"/>


            <TextBox x:Name="ContentTextBox"
                     Grid.Row="2"
                     Margin="4,12,4,8"
                     Background="Transparent"
                     BorderThickness="0"
                     FontFamily="Segoe Print"
                     FontSize="18"
                     Foreground="#FF29252F"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     SpellCheck.IsEnabled="True"/>


            <Border Grid.Row="3"
                    Height="1"
                    Background="#FF000000"
                    Opacity="0.12"/>


            <Grid Grid.Row="4"
                  Margin="0,6,0,0">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">

                    <Button x:Name="YellowButton"
                            Tag="#FFFFD75A"
                            Background="#FFFFD75A"
                            Style="{StaticResource ColorButtonStyle}"
                            Margin="0,0,7,0"
                            Click="ColorButton_Click"/>

                    <Button x:Name="CoralButton"
                            Tag="#FFFFA98F"
                            Background="#FFFFA98F"
                            Style="{StaticResource ColorButtonStyle}"
                            Margin="0,0,7,0"
                            Click="ColorButton_Click"/>

                    <Button x:Name="GreenButton"
                            Tag="#FF9CDBA2"
                            Background="#FF9CDBA2"
                            Style="{StaticResource ColorButtonStyle}"
                            Margin="0,0,7,0"
                            Click="ColorButton_Click"/>

                    <Button x:Name="BlueButton"
                            Tag="#FF9BCFEA"
                            Background="#FF9BCFEA"
                            Style="{StaticResource ColorButtonStyle}"
                            Margin="0,0,7,0"
                            Click="ColorButton_Click"/>

                    <Button x:Name="PurpleButton"
                            Tag="#FFD0B9F2"
                            Background="#FFD0B9F2"
                            Style="{StaticResource ColorButtonStyle}"
                            Click="ColorButton_Click"/>

                </StackPanel>


                <Button x:Name="DeleteButton"
                        Grid.Column="1"
                        Content="Delete"
                        Height="36"
                        Margin="8,0,6,0"
                        Style="{StaticResource DeleteButtonStyle}"
                        Click="DeleteButton_Click"/>


                <Button x:Name="CompleteButton"
                        Grid.Column="2"
                        Content="Mark complete"
                        Height="36"
                        Style="{StaticResource CompleteButtonStyle}"
                        Click="CompleteButton_Click"/>

            </Grid>

        </Grid>

    </Border>

</Window>