<Window x:Class="HoldMyNotes.Views.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520"
        Height="560"
        MinWidth="400"
        MinHeight="400"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <Style x:Key="FooterButtonStyle"
               TargetType="{x:Type Button}">

            <Setter Property="Height"
                    Value="38"/>

            <Setter Property="Padding"
                    Value="14,0"/>

            <Setter Property="Background"
                    Value="#22FFFFFF"/>

            <Setter Property="Foreground"
                    Value="#FF4D4753"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontFamily"
                    Value="Segoe UI"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="11"
                                SnapsToDevicePixels="True">

                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#40FFFFFF"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#55FFFFFF"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.35"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <Style x:Key="DeleteButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource FooterButtonStyle}">

            <Setter Property="Width"
                    Value="76"/>

            <Setter Property="Foreground"
                    Value="#FFAD4A4A"/>

            <Setter Property="Background"
                    Value="#12FFFFFF"/>

            <Setter Property="Padding"
                    Value="10,0"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border x:Name="DeleteBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="11"
                                SnapsToDevicePixels="True">

                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="DeleteBorder"
                                        Property="Background"
                                        Value="#32FFB5B5"/>

                                <Setter Property="Foreground"
                                        Value="#FF913535"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="DeleteBorder"
                                        Property="Background"
                                        Value="#48FF9D9D"/>

                                <Setter Property="Foreground"
                                        Value="#FF742525"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="DeleteBorder"
                                        Property="Opacity"
                                        Value="0.25"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <Style x:Key="CompleteButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource FooterButtonStyle}">

            <Setter Property="Width"
                    Value="116"/>

        </Style>


        <Style x:Key="CloseButtonStyle"
               TargetType="{x:Type Button}">

            <Setter Property="Width"
                    Value="34"/>

            <Setter Property="Height"
                    Value="34"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="#FF625C69"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border x:Name="CloseBorder"
                                Background="Transparent"
                                CornerRadius="10">

                            <TextBlock Text="X"
                                       FontFamily="Segoe UI"
                                       FontSize="15"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="CloseBorder"
                                        Property="Background"
                                        Value="#28FFFFFF"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="CloseBorder"
                                        Property="Background"
                                        Value="#40FFFFFF"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <Style x:Key="ColorButtonStyle"
               TargetType="{x:Type Button}">

            <Setter Property="Width"
                    Value="22"/>

            <Setter Property="Height"
                    Value="22"/>

            <Setter Property="Padding"
                    Value="0"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border x:Name="ColorBorder"
                                Width="22"
                                Height="22"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                SnapsToDevicePixels="True"/>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ColorBorder"
                                        Property="Opacity"
                                        Value="0.82"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ColorBorder"
                                        Property="Opacity"
                                        Value="0.65"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>


    <Border x:Name="NoteSurface"
            Background="#FFDCCBFF"
            CornerRadius="20">

        <Border.Effect>

            <DropShadowEffect
                BlurRadius="25"
                ShadowDepth="5"
                Direction="270"
                Opacity="0.22"/>

        </Border.Effect>


        <Grid Margin="20">

            <Grid.RowDefinitions>

                <RowDefinition Height="54"/>

                <RowDefinition Height="1"/>

                <RowDefinition Height="*"/>

                <RowDefinition Height="60"/>

            </Grid.RowDefinitions>


            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <Grid Grid.Column="0">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>


                    <TextBox x:Name="TitleTextBox"
                             Grid.Column="0"
                             Text="New Note"
                             Background="Transparent"
                             BorderThickness="0"
                             FontFamily="Segoe UI"
                             FontSize="22"
                             FontWeight="SemiBold"
                             Foreground="#FF29252F"
                             VerticalContentAlignment="Center"
                             Padding="0"
                             Margin="4,0,10,0"/>


                    <TextBlock x:Name="AutoSaveStatusText"
                               Grid.Column="1"
                               Text="Saved"
                               FontFamily="Segoe UI"
                               FontSize="11"
                               Foreground="#88625C69"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

                </Grid>


                <Button x:Name="CloseWindowButton"
                        Grid.Column="1"
                        Style="{StaticResource CloseButtonStyle}"
                        Click="CloseWindowButton_Click"/>

            </Grid>


            <Border Grid.Row="1"
                    Background="#30FFFFFF"/>


            <TextBox x:Name="ContentTextBox"
                     Grid.Row="2"
                     Margin="4,16,4,8"
                     Background="Transparent"
                     BorderThickness="0"
                     FontFamily="Segoe UI"
                     FontSize="20"
                     Foreground="#FF29252F"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     SpellCheck.IsEnabled="True"/>


            <Grid Grid.Row="3">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Button x:Name="YellowButton"
                            Tag="#FFFFD75A"
                            Background="#FFFFD75A"
                            Style="{StaticResource ColorButtonStyle}"
                            Margin="0,0,7,0"
                            Click="ColorButton_Click"/>

                    <Button x:Name="CoralButton"
                            Tag="#FFFFA98F"
                            Background="#FFFFA98F"
                            Style="{StaticResource ColorButtonStyle}"
                            Margin="0,0,7,0"
                            Click="ColorButton_Click"/>

                    <Button x:Name="GreenButton"
                            Tag="#FF9CDBA2"
                            Background="#FF9CDBA2"
                            Style="{StaticResource ColorButtonStyle}"
                            Margin="0,0,7,0"
                            Click="ColorButton_Click"/>

                    <Button x:Name="BlueButton"
                            Tag="#FF9BCFEA"
                            Background="#FF9BCFEA"
                            Style="{StaticResource ColorButtonStyle}"
                            Margin="0,0,7,0"
                            Click="ColorButton_Click"/>

                    <Button x:Name="PurpleButton"
                            Tag="#FFD0B9F2"
                            Background="#FFD0B9F2"
                            Style="{StaticResource ColorButtonStyle}"
                            Click="ColorButton_Click"/>

                </StackPanel>


                <Button x:Name="DeleteButton"
                        Grid.Column="1"
                        Content="Delete"
                        Style="{StaticResource DeleteButtonStyle}"
                        Height="38"
                        Margin="10,0,7,0"
                        Click="DeleteButton_Click"/>


                <Button x:Name="CompleteButton"
                        Grid.Column="2"
                        Content="Mark complete"
                        Style="{StaticResource CompleteButtonStyle}"
                        Height="38"
                        Click="CompleteButton_Click"/>

            </Grid>

        </Grid>

    </Border>

</Window>