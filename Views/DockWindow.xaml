<Window x:Class="HoldMyNotes.Views.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Width="250"
        Height="300"
        ResizeMode="NoResize"
        ShowActivated="False"
        Opacity="0">

    <Border Background="#DD222222"
            CornerRadius="12">

        <Grid>

            <TextBlock Text="HoldMyNotes"
                       Foreground="White"
                       FontSize="20"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

        </Grid>

    </Border>

</Window>