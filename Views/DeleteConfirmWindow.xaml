<Window x:Class="HoldMyNotes.Views.DeleteConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420"
        Height="230"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="True">

    <Window.Resources>

        <DropShadowEffect x:Key="DialogShadow"
                          BlurRadius="24"
                          ShadowDepth="6"
                          Direction="270"
                          Opacity="0.16"/>


        <Style x:Key="DialogButtonStyle"
               TargetType="{x:Type Button}">

            <Setter Property="Height"
                    Value="38"/>

            <Setter Property="Padding"
                    Value="16,0"/>

            <Setter Property="Background"
                    Value="#FFE9E7E0"/>

            <Setter Property="Foreground"
                    Value="#FF45433E"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontFamily"
                    Value="Segoe UI"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12">

                            <Grid>

                                <Border x:Name="ButtonHoverOverlay"
                                        Background="#1E000000"
                                        CornerRadius="12"
                                        Opacity="0"/>

                                <Border x:Name="ButtonPressedOverlay"
                                        Background="#30000000"
                                        CornerRadius="12"
                                        Opacity="0"/>

                                <TextBlock Text="{TemplateBinding Content}"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Grid>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Trigger.EnterActions>

                                    <BeginStoryboard>

                                        <Storyboard>

                                            <DoubleAnimation Storyboard.TargetName="ButtonHoverOverlay"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0:0:0.14">

                                                <DoubleAnimation.EasingFunction>

                                                    <QuinticEase EasingMode="EaseOut"/>

                                                </DoubleAnimation.EasingFunction>

                                            </DoubleAnimation>

                                        </Storyboard>

                                    </BeginStoryboard>

                                </Trigger.EnterActions>

                                <Trigger.ExitActions>

                                    <BeginStoryboard>

                                        <Storyboard>

                                            <DoubleAnimation Storyboard.TargetName="ButtonHoverOverlay"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.18">

                                                <DoubleAnimation.EasingFunction>

                                                    <QuinticEase EasingMode="EaseOut"/>

                                                </DoubleAnimation.EasingFunction>

                                            </DoubleAnimation>

                                        </Storyboard>

                                    </BeginStoryboard>

                                </Trigger.ExitActions>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Trigger.EnterActions>

                                    <BeginStoryboard>

                                        <Storyboard>

                                            <DoubleAnimation Storyboard.TargetName="ButtonPressedOverlay"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0:0:0.06"/>

                                        </Storyboard>

                                    </BeginStoryboard>

                                </Trigger.EnterActions>

                                <Trigger.ExitActions>

                                    <BeginStoryboard>

                                        <Storyboard>

                                            <DoubleAnimation Storyboard.TargetName="ButtonPressedOverlay"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.12"/>

                                        </Storyboard>

                                    </BeginStoryboard>

                                </Trigger.ExitActions>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <Style x:Key="DialogDeleteButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource DialogButtonStyle}">

            <Setter Property="Background"
                    Value="#FFE7B4AD"/>

            <Setter Property="Foreground"
                    Value="#FF87332C"/>

            <Setter Property="Padding"
                    Value="16,0"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border x:Name="DeleteBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12">

                            <Grid>

                                <Border x:Name="DeleteHoverOverlay"
                                        Background="#26000000"
                                        CornerRadius="12"
                                        Opacity="0"/>

                                <Border x:Name="DeletePressedOverlay"
                                        Background="#3A000000"
                                        CornerRadius="12"
                                        Opacity="0"/>

                                <TextBlock Text="{TemplateBinding Content}"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Grid>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Trigger.EnterActions>

                                    <BeginStoryboard>

                                        <Storyboard>

                                            <DoubleAnimation Storyboard.TargetName="DeleteHoverOverlay"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0:0:0.14">

                                                <DoubleAnimation.EasingFunction>

                                                    <QuinticEase EasingMode="EaseOut"/>

                                                </DoubleAnimation.EasingFunction>

                                            </DoubleAnimation>

                                        </Storyboard>

                                    </BeginStoryboard>

                                </Trigger.EnterActions>

                                <Trigger.ExitActions>

                                    <BeginStoryboard>

                                        <Storyboard>

                                            <DoubleAnimation Storyboard.TargetName="DeleteHoverOverlay"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.18">

                                                <DoubleAnimation.EasingFunction>

                                                    <QuinticEase EasingMode="EaseOut"/>

                                                </DoubleAnimation.EasingFunction>

                                            </DoubleAnimation>

                                        </Storyboard>

                                    </BeginStoryboard>

                                </Trigger.ExitActions>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Trigger.EnterActions>

                                    <BeginStoryboard>

                                        <Storyboard>

                                            <DoubleAnimation Storyboard.TargetName="DeletePressedOverlay"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0:0:0.06"/>

                                        </Storyboard>

                                    </BeginStoryboard>

                                </Trigger.EnterActions>

                                <Trigger.ExitActions>

                                    <BeginStoryboard>

                                        <Storyboard>

                                            <DoubleAnimation Storyboard.TargetName="DeletePressedOverlay"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.12"/>

                                        </Storyboard>

                                    </BeginStoryboard>

                                </Trigger.ExitActions>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <Style x:Key="DialogCloseButtonStyle"
               TargetType="{x:Type Button}">

            <Setter Property="Width"
                    Value="30"/>

            <Setter Property="Height"
                    Value="30"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border x:Name="CloseBorder"
                                Background="Transparent"
                                CornerRadius="9">

                            <Grid>

                                <Border x:Name="CloseHoverOverlay"
                                        Background="#FFEAE8E1"
                                        CornerRadius="9"
                                        Opacity="0"/>

                                <TextBlock Text="X"
                                           FontFamily="Segoe UI"
                                           FontSize="15"
                                           Foreground="#FF97938B"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Grid>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Trigger.EnterActions>

                                    <BeginStoryboard>

                                        <Storyboard>

                                            <DoubleAnimation Storyboard.TargetName="CloseHoverOverlay"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0:0:0.13">

                                                <DoubleAnimation.EasingFunction>

                                                    <QuinticEase EasingMode="EaseOut"/>

                                                </DoubleAnimation.EasingFunction>

                                            </DoubleAnimation>

                                        </Storyboard>

                                    </BeginStoryboard>

                                </Trigger.EnterActions>

                                <Trigger.ExitActions>

                                    <BeginStoryboard>

                                        <Storyboard>

                                            <DoubleAnimation Storyboard.TargetName="CloseHoverOverlay"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.16">

                                                <DoubleAnimation.EasingFunction>

                                                    <QuinticEase EasingMode="EaseOut"/>

                                                </DoubleAnimation.EasingFunction>

                                            </DoubleAnimation>

                                        </Storyboard>

                                    </BeginStoryboard>

                                </Trigger.ExitActions>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="CloseBorder"
                                        Property="Background"
                                        Value="#FFE0DED7"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>


    <Border Background="#FFF9F8F3"
            BorderBrush="#FFE1DED5"
            BorderThickness="1"
            CornerRadius="20"
            Effect="{StaticResource DialogShadow}">

        <Grid Margin="26">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="*"/>

                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>


            <Grid Grid.Row="0">

                <TextBlock Text="Delete note?"
                           FontFamily="Segoe UI"
                           FontSize="21"
                           FontWeight="SemiBold"
                           Foreground="#FF302F2C"/>


                <Button Style="{StaticResource DialogCloseButtonStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Click="CloseButton_Click"/>

            </Grid>


            <StackPanel Grid.Row="1"
                        Margin="0,18,0,14">

                <TextBlock x:Name="NoteNameText"
                           FontFamily="Segoe UI"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#FF45423D"
                           TextWrapping="Wrap"/>

                <TextBlock Text="This action cannot be undone."
                           Margin="0,8,0,0"
                           FontFamily="Segoe UI"
                           FontSize="13"
                           Foreground="#FF858178"
                           TextWrapping="Wrap"/>

            </StackPanel>


            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="Cancel"
                        Width="86"
                        Margin="0,0,8,0"
                        Style="{StaticResource DialogButtonStyle}"
                        Click="CancelButton_Click"/>

                <Button Content="Delete"
                        Width="86"
                        Style="{StaticResource DialogDeleteButtonStyle}"
                        Click="DeleteConfirmButton_Click"/>

            </StackPanel>

        </Grid>

    </Border>

</Window>